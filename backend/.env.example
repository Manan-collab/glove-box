NODE_ENV=development
PORT=3000

# Local Docker Postgres (see docker-compose.yml). Use a separate Neon/hosted
# URL for staging/production via your deploy platform's secrets, not this file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glovebox
# Optional: used by the Prisma CLI (migrate deploy) instead of DATABASE_URL.
# On Neon, set this to the direct host (no `-pooler`) — migrations time out
# with P1002 through the pooler. Unneeded for local Docker Postgres.
# DIRECT_URL=

JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret

FRONTEND_URL=http://localhost:3001

GOOGLE_CLIENT_ID='placeholder-until-google-console-setup'